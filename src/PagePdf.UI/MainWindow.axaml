<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="PagePdf.UI.MainWindow"
        Title="File Converter"
        Width="720"
        Height="520"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="OnDragOver"
        DragDrop.Drop="OnDrop">

	<DockPanel>

		<Border DockPanel.Dock="Bottom"
                Background="{DynamicResource StatusBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
			<DockPanel>
				<DockPanel DockPanel.Dock="Top">
					<TextBlock Name="StatusText"
                               DockPanel.Dock="Left"
                               Text="Ready"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" />

					<ProgressBar Name="ProgressBar"
                                 DockPanel.Dock="Right"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Height="6"
                                 Width="180"
                                 VerticalAlignment="Center"
                                 ShowProgressText="False" />
				</DockPanel>

				<StackPanel Name="QueuePanel"
                            Margin="0,4,0,0"
                            IsVisible="False">
					<StackPanel.Styles>
						<Style Selector="Border.badge">
							<Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
						</Style>
						<Style Selector="Border.badge TextBlock">
							<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
						</Style>
						<Style Selector="Border.badge.done">
							<Setter Property="Background" Value="#D1FAE5" />
						</Style>
						<Style Selector="Border.badge.done TextBlock">
							<Setter Property="Foreground" Value="#065F46" />
						</Style>
						<Style Selector="Border.badge.failed">
							<Setter Property="Background" Value="#FEE2E2" />
						</Style>
						<Style Selector="Border.badge.failed TextBlock">
							<Setter Property="Foreground" Value="#991B1B" />
						</Style>
						<Style Selector="Border.badge.converting">
							<Setter Property="Background" Value="#FEF3C7" />
						</Style>
						<Style Selector="Border.badge.converting TextBlock">
							<Setter Property="Foreground" Value="#92400E" />
						</Style>
					</StackPanel.Styles>

					<DockPanel Margin="0,0,0,4">
						<TextBlock Text="Queue"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
						<Button Name="ClearQueueButton"
                                DockPanel.Dock="Right"
                                Content="Clear"
                                Classes="subtle"
                                Click="ClearQueueButton_Click" />
					</DockPanel>

					<ScrollViewer MaxHeight="150"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
						<ItemsControl Name="QueueList"
                                      x:CompileBindings="False"
                                      FontSize="12">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,5"
                                            Margin="0,2">
										<DockPanel LastChildFill="True">
											<Button Name="RemoveButton"
                                                    Classes="icon"
                                                    DockPanel.Dock="Right"
                                                    Content="✕"
                                                    ToolTip.Tip="Remove from queue"
                                                    Click="RemoveQueueItem_Click" />
											<Border Name="StatusBadge"
                                                    Classes="badge"
                                                    Classes.queued="{Binding IsQueued}"
                                                    Classes.done="{Binding IsDone}"
                                                    Classes.failed="{Binding IsFailed}"
                                                    Classes.converting="{Binding IsConverting}"
                                                    DockPanel.Dock="Right"
                                                    CornerRadius="8"
                                                    Padding="8,2"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
												<TextBlock Text="{Binding Status}"
                                                           FontSize="11" />
											</Border>
											<TextBlock Text="{Binding FileName}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
										</DockPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</StackPanel>
			</DockPanel>
		</Border>

		<ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">

			<StackPanel MaxWidth="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="28"
                        Margin="48,40">

				<StackPanel Spacing="8"
                            HorizontalAlignment="Center">

					<TextBlock Text="CBZ to PDF Converter"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />

					<TextBlock Text="Convert .cbz comic archives to PDF"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />

				</StackPanel>

				<Border Name="DropZoneBorder"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="16"
                        Padding="36,44">

					<StackPanel Spacing="20"
                                HorizontalAlignment="Center">

						<Border Width="72"
                                Height="72"
                                CornerRadius="16"
                                Background="{DynamicResource AccentSoftBrush}"
                                HorizontalAlignment="Center">

							<TextBlock Text="CBZ"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

						</Border>

						<TextBlock Name="DropTitleText"
                                   Text="Drop a .cbz file here"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />

						<TextBlock Name="DropSubtitleText"
                                   Text="or select one or more from your computer"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,-12,0,0" />

						<StackPanel Orientation="Horizontal"
                                    Spacing="12"
                                    HorizontalAlignment="Center">

							<Button Name="OpenButton"
                                    Classes="primary"
                                    Content="Open"
                                    Click="OpenButton_Click" />
									<Button Name="ConvertButton"
                                            Classes="primary"
                                            Content="Convert"
                                            IsEnabled="False"
                                            Click="ConvertButton_Click" />

						</StackPanel>

					</StackPanel>

				</Border>

				<StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center">
					<TextBlock Text="Output folder:"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
					<Button Name="DefaultFolderButton"
                            Classes="subtle"
                            Content="Not selected"
                            Click="ChangeDefaultFolder_Click"
                            ToolTip.Tip="Current default output folder. Click to change." />
					<Button Name="ChangeFolderButton"
                            Classes="subtle"
                            Padding="8,4"
                            Content="&#x2026;"
                            ToolTip.Tip="Select a new default output folder"
                            Click="ChangeDefaultFolder_Click" />
				</StackPanel>

				<TextBlock Text="The output PDF keeps the original page order and image quality."
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" />

			</StackPanel>

		</ScrollViewer>

	</DockPanel>

</Window>
