<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="PagePdf.UI.MainWindow"
        Title="PagePdf"
        Width="720"
        Height="520"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="OnDragOver"
        DragDrop.Drop="OnDrop">

	<DockPanel>

		<Border DockPanel.Dock="Bottom"
                Background="{DynamicResource StatusBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
			<DockPanel>
				<DockPanel DockPanel.Dock="Top">
					<TextBlock Name="StatusText"
                               DockPanel.Dock="Left"
                               Text="Ready"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" />

					<ProgressBar Name="ProgressBar"
                                 DockPanel.Dock="Right"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Height="6"
                                 Width="180"
                                 VerticalAlignment="Center"
                                 ShowProgressText="False" />
				</DockPanel>

				<ItemsControl Name="QueueList"
                              Margin="0,4,0,0"
                              FontSize="12"
                              IsVisible="False">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</DockPanel>
		</Border>

		<ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">

			<StackPanel MaxWidth="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="28"
                        Margin="48,40">

				<StackPanel Spacing="8"
                            HorizontalAlignment="Center">

					<TextBlock Text="CBZ to PDF Converter"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />

					<TextBlock Text="Convert .cbz comic archives to PDF"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />

				</StackPanel>

				<Border Name="DropZoneBorder"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="16"
                        Padding="36,44">

					<StackPanel Spacing="20"
                                HorizontalAlignment="Center">

						<Border Width="72"
                                Height="72"
                                CornerRadius="16"
                                Background="{DynamicResource AccentSoftBrush}"
                                HorizontalAlignment="Center">

							<TextBlock Text="CBZ"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

						</Border>

						<TextBlock Name="DropTitleText"
                                   Text="Drop a .cbz file here"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />

						<TextBlock Name="DropSubtitleText"
                                   Text="or select one or more from your computer"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,-12,0,0" />

						<StackPanel Orientation="Horizontal"
                                    Spacing="12"
                                    HorizontalAlignment="Center">

							<Button Name="OpenButton"
                                    Classes="primary"
                                    Content="Open"
                                    Click="OpenButton_Click" />
									<Button Name="ConvertButton"
                                            Classes="primary"
                                            Content="Convert"
                                            IsEnabled="False"
                                            Click="ConvertButton_Click" />

						</StackPanel>

					</StackPanel>

				</Border>

				<TextBlock Text="The output PDF keeps the original page order and image quality."
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" />

			</StackPanel>

		</ScrollViewer>

	</DockPanel>

</Window>
